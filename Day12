# 17. Logistic Regression From Scratch 🔥

Now let's implement the core idea ourselves.

```python
import numpy as np

# Dataset
X = np.array([
    [1],
    [2],
    [3],
    [4],
    [5],
    [6]
], dtype=float)

y = np.array([0, 0, 0, 1, 1, 1], dtype=float)

# Initialize parameters
w = np.zeros(1)
b = 0.0

learning_rate = 0.1
epochs = 1000

def sigmoid(z):
    return 1 / (1 + np.exp(-z))

for epoch in range(epochs):

    # Linear combination
    z = X @ w + b

    # Convert to probabilities
    y_pred = sigmoid(z)

    # Gradients
    error = y_pred - y

    dw = (X.T @ error) / len(X)
    db = np.mean(error)

    # Update
    w -= learning_rate * dw
    b -= learning_rate * db

print("Weight:", w)
print("Bias:", b)
```

---

# 18. Add Prediction Logic

```python
def predict(X_new):

    z = X_new @ w + b

    probabilities = sigmoid(z)

    predictions = (probabilities >= 0.5).astype(int)

    return predictions


X_new = np.array([[2], [5]])

print(predict(X_new))
```

Expected conceptually:

```text
2 → Class 0
5 → Class 1
```

